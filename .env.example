# Local development. Copy to apps/web/.env and adjust. Never commit the real .env.
# Must match POSTGRES_PASSWORD in docker-compose.yml.
POSTGRES_PASSWORD="LocalDev_Pa55w0rd"

DATABASE_URL="postgresql://tm:LocalDev_Pa55w0rd@localhost:5433/transcendental_meditation"

# openssl rand -base64 32
AUTH_SECRET="replace-me-with-at-least-32-random-characters"

# Password for the "admin" user created by `pnpm db:seed`. Change it after first login.
SEED_ADMIN_PASSWORD="ChangeMe_12345"

# Vercel Blob has no local emulator. `vercel env pull` writes the real token to .env.local.
BLOB_READ_WRITE_TOKEN=""

# Optional meeting registration email delivery (verified Resend sender).
RESEND_API_KEY=
MEETINGS_FROM_EMAIL=
ADMIN_EMAIL=

# Pre-launch privacy controls; approval flags are attestations, not provider configuration.
PRIVACY_LAUNCH_APPROVED=false
PRIVACY_BACKUPS_VERIFIED=false
PRIVACY_LOG_RETENTION_VERIFIED=false
PRIVACY_PROCESSORS_VERIFIED=false
PRIVACY_EXTERNAL_DELETION_VERIFIED=false
PRIVACY_RIGHTS_PROCESS_VERIFIED=false
# Use the verified HTTPS origin in production.
SITE_URL=
# Optional local delivery must be explicitly enabled; leave disabled for synthetic tests.
PRIVACY_EMAIL_DELIVERY_ENABLED=false
# Local Docker database encrypted backups only. Keep the generated 32-byte base64 key secret.
PRIVACY_LOCAL_BACKUPS=false
PRIVACY_BACKUP_KEY=
# Development keeps the existing apps/web/private directory when unset.
# Production REQUIRES an absolute durable directory outside the entire release tree.
# Configure/mount it explicitly; never point it at public/, build output or source.
PRIVACY_STORAGE_DIR=

# Separate local-only Google Calendar OAuth test (never use NEXT_PUBLIC_).
# Full Google Cloud setup: docs/google-calendar-local-test.md.
GOOGLE_CALENDAR_TEST_ENABLED=false
GOOGLE_CALENDAR_TEST_CLIENT_ID=
GOOGLE_CALENDAR_TEST_CLIENT_SECRET=
GOOGLE_CALENDAR_TEST_EMAIL=
