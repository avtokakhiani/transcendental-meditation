// Azure SQL Database (SQL Server) — see docker-compose.yml for the local equivalent.
//
// Two provider constraints shape this file:
//   1. No native enums, so statuses are NVARCHAR mirroring @tm/shared.
//   2. SQL Server rejects multiple cascade paths to the same table, so child rows cascade from
//      exactly one parent and every other relation uses NoAction.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

/// Staff who manage content. Readers never sign in.
model User {
  id           String    @id @default(uuid()) @db.UniqueIdentifier
  username     String    @unique @db.NVarChar(80)
  email        String    @unique @db.NVarChar(320)
  passwordHash String    @db.NVarChar(255)
  firstName    String    @db.NVarChar(100)
  lastName     String    @db.NVarChar(100)
  role         String    @default("editor") @db.NVarChar(20)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  posts Post[]

  @@map("users")
}

model Post {
  id            String    @id @default(uuid()) @db.UniqueIdentifier
  /// Latin-only so shared links stay readable; see slugify in @tm/shared.
  slug          String    @unique @db.NVarChar(120)
  title         String    @db.NVarChar(300)
  /// Shown on cards and in meta tags. Derived from content when empty.
  excerpt       String?   @db.NVarChar(500)
  coverImageUrl String?   @db.NVarChar(2048)
  /// Markdown (legacy) or editor HTML, per contentFormat. HTML is sanitized on save and on render.
  content       String    @db.NVarChar(Max)
  contentFormat String    @default("markdown") @db.NVarChar(10)
  status        String    @default("draft") @db.NVarChar(20)
  /// Set on first publish and kept on unpublish/republish so the post keeps its place in the feed.
  publishedAt   DateTime?
  authorId      String?   @db.UniqueIdentifier
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, publishedAt])
  @@map("posts")
}

model Book {
  id            String    @id @default(uuid()) @db.UniqueIdentifier
  slug          String    @unique @db.NVarChar(120)
  title         String    @db.NVarChar(300)
  author        String?   @db.NVarChar(200)
  description   String?   @db.NVarChar(4000)
  coverImageUrl String?   @db.NVarChar(2048)
  status        String    @default("draft") @db.NVarChar(20)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pages BookPage[]
  featuredIn HomepageSettings[]

  @@index([status, publishedAt])
  @@map("books")
}

/// One screen of reading. Numbers are contiguous from 1 and form the reader URL (/books/x/3).
model BookPage {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  bookId    String   @db.UniqueIdentifier
  number    Int
  /// Optional chapter heading; titled pages make up the book's table of contents.
  title     String?  @db.NVarChar(300)
  /// Same formats and renderer as posts.
  content       String   @db.NVarChar(Max)
  contentFormat String   @default("markdown") @db.NVarChar(10)
  status        String   @default("published") @db.NVarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, number])
  @@map("book_pages")
}

/// Singleton homepage preferences; featured content never follows publication order.
model HomepageSettings {
  id             Int     @id @default(1)
  featuredBookId String? @db.UniqueIdentifier
  featuredBook   Book?   @relation(fields: [featuredBookId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("homepage_settings")
}

/// Images uploaded by editors, served publicly through /api/media/[id].
model Media {
  id           String   @id @default(uuid()) @db.UniqueIdentifier
  /// Blob name within the media container; never a full URL so the storage account can move.
  blobName     String   @unique @db.NVarChar(400)
  contentType  String   @db.NVarChar(100)
  byteSize     Int
  originalName String   @db.NVarChar(260)
  uploadedById String?  @db.UniqueIdentifier
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("media")
}
