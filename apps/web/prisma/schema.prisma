// Azure SQL Database (SQL Server) — see docker-compose.yml for the local equivalent.
//
// Two provider constraints shape this file:
//   1. No native enums, so statuses are NVARCHAR mirroring @tm/shared.
//   2. SQL Server rejects multiple cascade paths to the same table, so child rows cascade from
//      exactly one parent and every other relation uses NoAction.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

/// All instants are UTC; editors enter dates in Asia/Tbilisi. Drafts are private.
model IntroductoryMeeting {
  id                   String   @id @default(uuid()) @db.UniqueIdentifier
  startsAt             DateTime @db.DateTime2
  format               String   @db.NVarChar(20)
  location             String?  @db.NVarChar(500)
  joiningInstructions  String?  @db.NVarChar(2000)
  status               String   @default("draft") @db.NVarChar(20)
  capacity             Int?
  registrationClosesAt DateTime? @db.DateTime2
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  registrations        MeetingRegistration[]

  @@index([status, startsAt])
  @@map("introductory_meetings")
}

/// Never included in public meeting responses. Notification timestamps form a retryable outbox.
model MeetingRegistration {
  id                     String   @id @default(uuid()) @db.UniqueIdentifier
  meetingId              String   @db.UniqueIdentifier
  firstName              String   @db.NVarChar(100)
  lastName               String   @db.NVarChar(100)
  email                  String   @db.NVarChar(254)
  phone                  String   @db.NVarChar(40)
  createdAt              DateTime @default(now())
  adminNotifiedAt        DateTime?
  participantNotifiedAt  DateTime?
  adminEmailId           String?  @db.NVarChar(100)
  participantEmailId     String?  @db.NVarChar(100)
  retentionExpiresAt     DateTime @default(dbgenerated("DATEADD(month, 12, SYSUTCDATETIME())")) @db.DateTime2
  processingRestrictedAt DateTime?
  holdUntil              DateTime?
  holdReason             String?  @db.NVarChar(40)
  meeting                IntroductoryMeeting @relation(fields: [meetingId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([meetingId, email])
  @@index([retentionExpiresAt])
  @@map("meeting_registrations")
}

/// Corporate correspondence is stored privately; email notifications contain no enquiry content.
model CorporateInquiry {
  id                     String   @id @default(uuid()) @db.UniqueIdentifier
  deduplicationKey       String   @unique @db.VarChar(64)
  name                   String   @db.NVarChar(150)
  organization           String   @db.NVarChar(200)
  email                  String   @db.NVarChar(254)
  phone                  String   @db.NVarChar(40)
  contactMethod          String   @db.NVarChar(40)
  message                String   @db.NVarChar(Max)
  createdAt              DateTime @default(now())
  lastBusinessContactAt  DateTime @db.DateTime2
  retentionExpiresAt     DateTime @db.DateTime2
  processingRestrictedAt DateTime?
  holdUntil              DateTime?
  holdReason             String?  @db.NVarChar(40)
  adminNotifiedAt        DateTime?
  adminEmailId           String?  @db.NVarChar(100)
  @@index([retentionExpiresAt])
  @@map("corporate_inquiries")
}

/// No enquiry text, names, addresses, or IPs. Purged after 90 days.
model PrivacyAudit {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  actorId   String?  @db.UniqueIdentifier
  scope     String   @db.NVarChar(30)
  targetId  String?  @db.UniqueIdentifier
  action    String   @db.NVarChar(40)
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@map("privacy_audit")
}

/// Minimal deletion ledger for restoring backups without resurrecting erased records.
model PrivacyErasure {
  id              String   @id @default(uuid()) @db.UniqueIdentifier
  scope           String   @db.NVarChar(30)
  targetId        String   @db.UniqueIdentifier
  externalEmailIds String?  @db.NVarChar(500)
  externalDoneAt  DateTime?
  createdAt       DateTime @default(now())
  @@index([createdAt])
  @@map("privacy_erasures")
}

/// Staff who manage content. Readers never sign in.
model User {
  id           String    @id @default(uuid()) @db.UniqueIdentifier
  username     String    @unique @db.NVarChar(80)
  email        String    @unique @db.NVarChar(320)
  passwordHash String    @db.NVarChar(255)
  firstName    String    @db.NVarChar(100)
  lastName     String    @db.NVarChar(100)
  role         String    @default("editor") @db.NVarChar(20)
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  posts Post[]

  @@map("users")
}

model Post {
  id            String    @id @default(uuid()) @db.UniqueIdentifier
  /// Latin-only so shared links stay readable; see slugify in @tm/shared.
  slug          String    @unique @db.NVarChar(120)
  title         String    @db.NVarChar(300)
  /// Shown on cards and in meta tags. Derived from content when empty.
  excerpt       String?   @db.NVarChar(500)
  coverImageUrl String?   @db.NVarChar(2048)
  /// Markdown (legacy) or editor HTML, per contentFormat. HTML is sanitized on save and on render.
  content       String    @db.NVarChar(Max)
  contentFormat String    @default("markdown") @db.NVarChar(10)
  status        String    @default("draft") @db.NVarChar(20)
  /// Set on first publish and kept on unpublish/republish so the post keeps its place in the feed.
  publishedAt   DateTime?
  authorId      String?   @db.UniqueIdentifier
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author User? @relation(fields: [authorId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, publishedAt])
  @@map("posts")
}

model Book {
  id            String    @id @default(uuid()) @db.UniqueIdentifier
  slug          String    @unique @db.NVarChar(120)
  title         String    @db.NVarChar(300)
  author        String?   @db.NVarChar(200)
  description   String?   @db.NVarChar(4000)
  coverImageUrl String?   @db.NVarChar(2048)
  status        String    @default("draft") @db.NVarChar(20)
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  pages BookPage[]
  featuredIn HomepageSettings[]

  @@index([status, publishedAt])
  @@map("books")
}

/// One screen of reading. Numbers are contiguous from 1 and form the reader URL (/books/x/3).
model BookPage {
  id        String   @id @default(uuid()) @db.UniqueIdentifier
  bookId    String   @db.UniqueIdentifier
  number    Int
  /// Optional chapter heading; titled pages make up the book's table of contents.
  title     String?  @db.NVarChar(300)
  /// Same formats and renderer as posts.
  content       String   @db.NVarChar(Max)
  contentFormat String   @default("markdown") @db.NVarChar(10)
  status        String   @default("published") @db.NVarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, number])
  @@map("book_pages")
}

/// Singleton homepage preferences; featured content never follows publication order.
model HomepageSettings {
  id             Int     @id @default(1)
  featuredBookId String? @db.UniqueIdentifier
  featuredBook   Book?   @relation(fields: [featuredBookId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@map("homepage_settings")
}

/// Images uploaded by editors, served publicly through /api/media/[id].
model Media {
  id           String   @id @default(uuid()) @db.UniqueIdentifier
  /// Blob name within the media container; never a full URL so the storage account can move.
  blobName     String   @unique @db.NVarChar(400)
  contentType  String   @db.NVarChar(100)
  byteSize     Int
  originalName String   @db.NVarChar(260)
  uploadedById String?  @db.UniqueIdentifier
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@map("media")
}
